# Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
JWT_SECRET=change-this-to-a-long-random-string

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ====== Integrações (APIs de Scraping) ======
# ScrapingBee - Proxy para contornar bloqueios de scraping
# https://www.scrapingbee.com/
SCRAPINGBEE_API_KEY=

# ====== SHEIN ======
SHEIN_API_ENABLED=false
SHEIN_API_BASE_URL=
SHEIN_APP_ID=
SHEIN_APP_SECRET=
SHEIN_ACCESS_TOKEN=

# ====== AliExpress ======
ALIEXPRESS_API_ENABLED=false
# Opção 1: API Oficial (requer aprovação)
ALIEXPRESS_API_KEY=
ALIEXPRESS_API_SECRET=
# Opção 2: RapidAPI - AliExpress Data Scraper
RAPIDAPI_KEY=

# ====== Vinted ======
VINTED_API_ENABLED=false
# Vinted não tem API oficial - usar scraping via ScrapingBee ou Apify

# ====== Câmbio (opcional) ======
# API para atualizar taxas de câmbio automaticamente
# https://open.er-api.com/
EXCHANGE_API_KEY=

# ====== Pagamentos (futuro) ======
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=

# ====== WhatsApp (futuro) ======
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ====== Email (futuro) ======
RESEND_API_KEY=